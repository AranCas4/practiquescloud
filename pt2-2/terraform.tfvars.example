# Copia aquest fitxer com a terraform.tfvars i ajusta els valors si cal.
# No pugis mai terraform.tfvars ni les credencials al repositori.

aws_region     = "us-east-1"
project_name   = "pt2-2"
vpc_cidr       = "10.0.0.0/16"
subnet_a_cidr  = "10.0.1.0/24"
subnet_b_cidr  = "10.0.2.0/24"
az_a           = "us-east-1a"
az_b           = "us-east-1b"
instance_type  = "t3.micro"
key_name       = "vockey"   # Key Pair d'AWS Academy. Canvia'l si en fas servir un altre.
